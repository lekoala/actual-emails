# Normalise line endings to LF in the repository and working tree.
* text=auto eol=lf

*.php    text eol=lf diff=php
*.twig   text eol=lf
*.css    text eol=lf diff=css
*.html   text eol=lf diff=html
*.txt    text eol=lf
*.md     text eol=lf diff=markdown
*.json   text eol=lf
*.lock   text eol=lf -diff

# Generated output, committed only to ease evaluation (do not hand-edit).
/dist/** linguist-generated=true

# Keep development-only files out of `git archive` / Composer dist archives.
/.temp           export-ignore
/tests           export-ignore
/.gitattributes  export-ignore
/.gitignore      export-ignore
