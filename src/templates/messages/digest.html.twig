{% extends 'layout.html.twig' %}
{% block content %}
<p class="email-lead">Hello {{ recipient.first_name }}, here is an overview of your day. Everything that matters, in one place.</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" class="email-kpi"><tr><td class="email-kpi-cell">
  <div class="email-kpi-number">{{ digest.count }}</div>
  <div class="email-kpi-label">Appointments scheduled today</div>
</td></tr></table>
{{ include('components/spacer.html.twig', {'size': 20}, with_context = false) }}
{{ include('components/digest_list.html.twig', {'items': digest['items']}, with_context = false) }}
{{ include('components/spacer.html.twig', {'size': 28}, with_context = false) }}
{{ include('components/button.html.twig', {'label': 'Open my calendar', 'url': digest.url}, with_context = false) }}
<div class="email-action-help">To protect personal data, this message contains no clinical information.</div>
{% endblock %}
