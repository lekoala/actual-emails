{% extends 'layout.html.twig' %}
{% block content %}
<p class="email-lead">Hello {{ recipient.first_name }}, enter this code to finish signing in.</p>
{{ include('components/code.html.twig', {'code': security.code, 'label': 'Valid for ' ~ security.minutes ~ ' minutes'}, with_context = false) }}
{{ include('components/spacer.html.twig', {'size': 20}, with_context = false) }}
<p class="email-text">Never share this code, not even with our team. We will never ask for it by phone or email.</p>
<p class="email-text">Requested on {{ security.requested }}, from {{ security.device }}.</p>
{{ include('components/spacer.html.twig', {'size': 16}, with_context = false) }}
{{ include('components/notice.html.twig', {'warning': true, 'message': 'Didn’t request this code? Review your account security.', 'link': {'label': 'Change your password', 'url': security.password_url}}, with_context = false) }}
{% endblock %}
