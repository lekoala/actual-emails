{% extends 'layout.html.twig' %}
{% block content %}
<p class="email-lead">Hello {{ recipient.first_name }}, enter this code to finish signing in.</p>
{{ include('components/code.html.twig', {'code': security.code, 'label': 'Verification code'}, with_context = false) }}
{{ include('components/spacer.html.twig', {'size': 20}, with_context = false) }}
<p class="email-text">It expires in <strong class="email-strong">{{ security.minutes }} minutes</strong>. Never share it, not even with our team.</p>
<p class="email-text">Requested on {{ security.requested }}.</p>
{{ include('components/spacer.html.twig', {'size': 16}, with_context = false) }}
{{ include('components/notice.html.twig', {'warning': true, 'message': 'Didn’t try to sign in? Someone may know your password.', 'link': {'label': 'Change your password', 'url': security.password_url}}, with_context = false) }}
{% endblock %}
