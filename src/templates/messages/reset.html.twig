{% extends 'layout.html.twig' %}
{% block content %}
<p class="email-lead">Hello {{ recipient.first_name }}, use this button to choose a new password. The link works once and expires in <strong class="email-strong">{{ reset.minutes }} minutes</strong>.</p>
{{ include('components/button.html.twig', {'label': 'Choose a new password', 'url': reset.url}, with_context = false) }}
{{ include('components/subcopy.html.twig', {'url': reset.url, 'label': brand.fallback_link_label}, with_context = false) }}
{{ include('components/spacer.html.twig', {'size': 28}, with_context = false) }}
<p class="email-text">Requested on {{ reset.requested }}, from {{ reset.device }}.</p>
{{ include('components/spacer.html.twig', {'size': 16}, with_context = false) }}
{{ include('components/notice.html.twig', {'message': 'Didn’t ask for this? You can ignore this email; your password stays the same.'}, with_context = false) }}
{% endblock %}
