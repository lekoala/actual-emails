{% extends 'layout.html.twig' %}
{% block content %}
<p class="email-lead">Hello {{ recipient.first_name }}, your appointment with <strong class="email-strong">{{ appointment.practitioner }}</strong> is confirmed.</p>
{{ include('components/details.html.twig', {'items': appointment.details}, with_context = false) }}
{{ include('components/spacer.html.twig', {'size': 28}, with_context = false) }}
{{ include('components/button.html.twig', {'label': 'Manage my appointment', 'url': appointment.url}, with_context = false) }}
<div class="email-action-help">Can’t make it? Reschedule or cancel from the same page, up to {{ appointment.cancel_notice }} before, so the slot can go to someone else.</div>
{% endblock %}
