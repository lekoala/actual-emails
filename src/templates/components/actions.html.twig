{# One or two actions. They sit side by side on desktop and stack full-width
   under 620px, so translated labels can grow. Use a text link below for longer
   alternatives instead of a third button. #}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" class="email-actions"><tr>
  {% if primary %}
  <td class="email-action-cell">{{ include('components/button.html.twig', {'label': primary.label, 'url': primary.url, 'variant': 'primary'}, with_context = false) }}</td>
  {% endif %}
  {% if secondary is defined and secondary %}
  <td class="email-action-cell email-action-next">{{ include('components/button.html.twig', {'label': secondary.label, 'url': secondary.url, 'variant': 'secondary'}, with_context = false) }}</td>
  {% endif %}
</tr></table>
