<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" class="email-list">
  {% for item in items %}
  <tr>
    <td class="email-list-time{{ loop.first ? '' : ' email-list-sep' }}" valign="top">{{ item.time }}</td>
    <td class="email-list-cell{{ loop.first ? '' : ' email-list-sep' }}"><div class="email-list-title">{{ item.title }}</div><div class="email-list-sub">{{ item.subtitle }}</div></td>
  </tr>
  {% endfor %}
</table>
