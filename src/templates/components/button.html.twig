{# Email-safe bulletproof-ish primary or secondary action. Never rely solely on the button:
   pair it with a human-readable fallback URL if security/access is involved.
   `variant` is explicit so caller context cannot leak into the style.
   The table is `email-button` so the border model stays separate and the
   rounded border is not squared off. #}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" class="email-button"><tr>
  {% if variant|default('primary') == 'secondary' %}
  <td class="email-button-ghost-td" align="center"><a class="email-button-ghost-link" href="{{ url }}">{{ label }}</a></td>
  {% else %}
  <td class="email-button-td" bgcolor="{{ theme.accent }}" align="center"><a class="email-button-link" href="{{ url }}">{{ label }}</a></td>
  {% endif %}
</tr></table>
