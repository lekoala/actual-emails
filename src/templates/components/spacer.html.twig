{# Valid sizes: 16, 20, 28. A div with an exact line-height, not a table:
   Word-based Outlook merges adjacent tables (the spacer row then inherits its
   neighbour's background and borders) and ignores CSS height on cells.
   The lookup keeps literal class names in the source so class scanners still
   see them, and an invalid size fails at render instead of emitting no rule. #}
{% set classes = {16: 'email-space-16', 20: 'email-space-20', 28: 'email-space-28'} %}
<div class="{{ classes[size|default(20)] }}" aria-hidden="true">&nbsp;</div>
